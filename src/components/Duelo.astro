---
import { ArrowUpRightIcon, CrosshairIcon } from "@lucide/astro";
import atacante from "../assets/blackout/atacante-720.webp";
import atacanteSmall from "../assets/blackout/atacante-320.webp";
import atacanteMedium from "../assets/blackout/atacante-480.webp";
import defensor from "../assets/blackout/defensor-720.webp";
import defensorSmall from "../assets/blackout/defensor-320.webp";
import defensorMedium from "../assets/blackout/defensor-480.webp";
---

<article class="duelo border border-border bg-card" aria-labelledby="duelo-title">
    <div class="duelo-header font-mono">
        <p class="flex items-center gap-2 text-accent">
            <CrosshairIcon size={14} class="shrink-0" />
            BLACKOUT // ARENA
        </p>
        <p class="text-muted-foreground">ATAQUE &amp; DEFENSA</p>
    </div>

    <div class="duelo-stage">
        <figure
            class="competidor competidor-ataque"
            tabindex="0"
            aria-label="Atacante: root.404"
            aria-describedby="atacante-info"
            data-competidor
        >
            <span class="operator-id font-mono" aria-hidden="true">OP_01 / ATK</span>
            <span class="selection-scan" aria-hidden="true"></span>
            <img
                src={atacante.src}
                srcset={`${atacanteSmall.src} 320w, ${atacanteMedium.src} 480w, ${atacante.src} 720w`}
                width={atacante.width}
                height={atacante.height}
                alt="Retrato ilustrativo de un competidor mirando hacia su oponente a la derecha."
                sizes="(min-width: 1280px) 480px, (min-width: 640px) 42vw, 50vw"
                loading="lazy"
                decoding="async"
                class="portrait"
            />
            <figcaption class="competidor-caption">
                <span class="competidor-label font-mono text-accent">01 / INFILTRA</span>
                <strong class="competidor-name font-mono">ATACANTE</strong>
                <span class="competidor-description">Encuentra la brecha.</span>
            </figcaption>
            <div id="atacante-info" class="player-tooltip font-mono" role="tooltip">
                <span class="player-tooltip-label">// PERFIL DE OPERADOR</span>
                <strong class="player-alias">root.404</strong>
                <span class="player-team">NULL POINTERS</span>
            </div>
        </figure>

        <div class="versus font-mono" aria-label="contra">
            <span class="versus-kicker" aria-hidden="true">UN MISMO SISTEMA</span>
            <span class="versus-symbol" aria-hidden="true">VS</span>
            <span class="versus-line" aria-hidden="true"></span>
            <span class="versus-kicker" aria-hidden="true">DOS ESTRATEGIAS</span>
        </div>

        <figure
            class="competidor competidor-defensa"
            tabindex="0"
            aria-label="Defensora: n0cturnal"
            aria-describedby="defensora-info"
            data-competidor
        >
            <span class="operator-id font-mono" aria-hidden="true">OP_02 / DEF</span>
            <span class="selection-scan" aria-hidden="true"></span>
            <img
                src={defensor.src}
                srcset={`${defensorSmall.src} 320w, ${defensorMedium.src} 480w, ${defensor.src} 720w`}
                width={defensor.width}
                height={defensor.height}
                alt="Retrato ilustrativo de una competidora mirando hacia su oponente a la izquierda."
                sizes="(min-width: 1280px) 480px, (min-width: 640px) 42vw, 50vw"
                loading="lazy"
                decoding="async"
                class="portrait"
            />
            <figcaption class="competidor-caption">
                <span class="competidor-label font-mono text-accent">02 / RESISTE</span>
                <strong class="competidor-name font-mono">DEFENSOR</strong>
                <span class="competidor-description">Protege el sistema.</span>
            </figcaption>
            <div id="defensora-info" class="player-tooltip font-mono" role="tooltip">
                <span class="player-tooltip-label">// PERFIL DE OPERADOR</span>
                <strong class="player-alias">n0cturnal</strong>
                <span class="player-team">GH0ST DIVISION</span>
            </div>
        </figure>
    </div>

    <div class="duelo-footer">
        <div class="min-w-0 space-y-3">
            <p class="font-mono text-[10px] tracking-widest text-accent">TU INGENIO ES TU MEJOR ARMA</p>
            <h3 id="duelo-title" class="font-mono text-xl font-bold sm:text-2xl">
                EL SIGUIENTE MOVIMIENTO <span class="text-accent">ES TUYO.</span>
            </h3>
            <p class="max-w-xl text-sm leading-relaxed text-muted-foreground">
                Encuentra lo que otros no ven. Defiende lo que otros quieren romper.
                Elige tu modalidad y lleva tus habilidades al campo de juego.
            </p>
        </div>
        <a
            href="#modalidades"
            class="flex min-h-12 shrink-0 items-center justify-center gap-3 bg-accent px-5 py-4 font-mono text-[10px] font-bold tracking-widest text-primary-foreground transition-colors hover:bg-foreground hover:text-background"
        >
            ELIGE TU BATALLA
            <ArrowUpRightIcon size={16} class="shrink-0" />
        </a>
    </div>
</article>

<script>
    const cards = document.querySelectorAll<HTMLElement>("[data-competidor]");

    cards.forEach((card) => {
        const resetTooltip = () => delete card.dataset.infoDismissed;
        card.addEventListener("pointerenter", resetTooltip);
        card.addEventListener("focus", resetTooltip);
    });

    document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;

        cards.forEach((card) => {
            if (card.matches(":hover") || card === document.activeElement) {
                card.dataset.infoDismissed = "true";
            }
        });
    });
</script>

<style>
    .duelo {
        overflow: clip;
    }

    .duelo-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem;
        border-bottom: 1px solid var(--border);
        font-size: 0.5625rem;
        letter-spacing: 0.14em;
    }

    .duelo-stage {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        isolation: isolate;
        background: radial-gradient(ellipse at 50% 90%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 65%);
    }

    .competidor {
        position: relative;
        min-width: 0;
        height: clamp(19rem, 40vw, 30rem);
        overflow: hidden;
        transition: background-color 220ms ease, box-shadow 220ms ease;
        outline-offset: -3px;
    }

    .competidor::before {
        position: absolute;
        inset: 0.75rem;
        z-index: 3;
        content: "";
        pointer-events: none;
        opacity: 0;
        background:
            linear-gradient(var(--accent), var(--accent)) top left / 1.5rem 2px,
            linear-gradient(var(--accent), var(--accent)) top left / 2px 1.5rem,
            linear-gradient(var(--accent), var(--accent)) top right / 1.5rem 2px,
            linear-gradient(var(--accent), var(--accent)) top right / 2px 1.5rem,
            linear-gradient(var(--accent), var(--accent)) bottom left / 1.5rem 2px,
            linear-gradient(var(--accent), var(--accent)) bottom left / 2px 1.5rem,
            linear-gradient(var(--accent), var(--accent)) bottom right / 1.5rem 2px,
            linear-gradient(var(--accent), var(--accent)) bottom right / 2px 1.5rem;
        background-repeat: no-repeat;
        transition: opacity 220ms ease;
    }

    .competidor::after {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background: linear-gradient(180deg, transparent 40%, color-mix(in oklab, var(--card) 60%, transparent) 72%, var(--card) 100%);
    }

    .competidor-defensa {
        border-left: 1px solid var(--border);
    }

    .portrait {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 25%;
        mix-blend-mode: screen;
        transition: filter 250ms ease;
    }

    .competidor-defensa .portrait {
        transform: translateY(0.25rem) scale(0.9);
        transform-origin: center;
    }

    .selection-scan {
        position: absolute;
        inset: 0;
        z-index: 2;
        opacity: 0;
        pointer-events: none;
        background: linear-gradient(transparent 49.5%, color-mix(in oklab, var(--accent) 60%, transparent) 50%, transparent 50.5%);
    }

    .player-tooltip {
        position: absolute;
        bottom: 8.5rem;
        left: 2rem;
        z-index: 4;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        width: min(14rem, calc(100% - 4rem));
        padding: 1rem 1.25rem;
        border: 1px solid var(--accent);
        background: var(--card);
        box-shadow: 0 0.5rem 2rem #0009;
        opacity: 0;
        visibility: hidden;
        transform: translateY(0.5rem);
        transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
    }

    .competidor-defensa .player-tooltip {
        right: 2rem;
        left: auto;
    }

    .player-tooltip-label {
        color: var(--accent);
        font-size: 0.5rem;
        letter-spacing: 0.12em;
    }

    .player-alias {
        color: var(--foreground);
        font-size: 1.25rem;
    }

    .player-team {
        color: var(--muted-foreground);
        font-size: 0.625rem;
        letter-spacing: 0.12em;
    }

    .operator-id {
        position: absolute;
        top: 1rem;
        left: 1rem;
        z-index: 1;
        font-size: 0.5rem;
        letter-spacing: 0.14em;
        color: var(--muted-foreground);
    }

    .competidor-defensa .operator-id {
        right: 1rem;
        left: auto;
    }

    .competidor-caption {
        position: absolute;
        right: 0.75rem;
        bottom: 1.5rem;
        left: 0.75rem;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .competidor-defensa .competidor-caption {
        text-align: right;
    }

    .competidor-label {
        font-size: 0.5rem;
        letter-spacing: 0.18em;
    }

    .competidor-name {
        font-size: clamp(1rem, 3vw, 2.5rem);
        line-height: 1.1;
        letter-spacing: -0.04em;
    }

    .competidor-description {
        font-size: 0.6875rem;
        color: var(--muted-foreground);
    }

    .versus {
        position: absolute;
        top: 44%;
        left: 50%;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        transform: translate(-50%, -50%);
        text-align: center;
        pointer-events: none;
    }

    .versus-symbol {
        padding: 0.625rem 0.5rem;
        border: 1px solid var(--border);
        background: var(--card);
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.08em;
    }

    .versus-kicker,
    .versus-line {
        display: none;
    }

    .duelo-footer {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        border-top: 1px solid var(--border);
        padding: 1.5rem;
    }

    @media (min-width: 40rem) {
        .duelo-header {
            padding: 1.25rem 2rem;
            font-size: 0.625rem;
        }

        .portrait {
            object-fit: contain;
            object-position: center;
        }

        .operator-id {
            top: 1.5rem;
            left: 2rem;
            font-size: 0.625rem;
        }

        .competidor-defensa .operator-id {
            right: 2rem;
        }

        .competidor-caption {
            right: 2rem;
            bottom: 2rem;
            left: 2rem;
            gap: 0.5rem;
        }

        .competidor-label {
            font-size: 0.625rem;
        }

        .competidor-description {
            font-size: 0.875rem;
        }

        .versus-symbol {
            padding: 1rem;
            font-size: clamp(3rem, 6vw, 5rem);
        }

        .duelo-footer {
            padding: 2rem;
        }
    }

    @media (min-width: 64rem) {
        .competidor:focus-visible {
            background-color: color-mix(in oklab, var(--accent) 5%, transparent);
            box-shadow: inset 0 0 0 1px var(--accent);
        }

        .competidor:focus-visible::before {
            opacity: 1;
        }

        .competidor:focus-visible .portrait {
            filter: brightness(1.18) contrast(1.05);
        }

        .competidor:focus-visible:not([data-info-dismissed]) .player-tooltip {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .versus-kicker {
            display: block;
            color: var(--muted-foreground);
            font-size: 0.5625rem;
            letter-spacing: 0.16em;
        }

        .versus-line {
            display: block;
            width: 1.5rem;
            height: 2px;
            background: var(--accent);
        }

        .duelo-footer {
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 2rem;
        }
    }

    @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
        .competidor {
            cursor: crosshair;
        }

        .competidor:hover {
            background-color: color-mix(in oklab, var(--accent) 5%, transparent);
            box-shadow: inset 0 0 0 1px var(--accent);
        }

        .competidor:hover::before {
            opacity: 1;
        }

        .competidor:hover .portrait {
            filter: brightness(1.18) contrast(1.05);
        }

        .competidor:hover:not([data-info-dismissed]) .player-tooltip {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .competidor:is(:hover, :focus-visible) .selection-scan {
            animation: selection-scan 700ms ease-out;
        }
    }

    @keyframes selection-scan {
        from {
            opacity: 0;
            transform: translateY(-100%);
        }
        30%, 70% {
            opacity: 1;
        }
        to {
            opacity: 0;
            transform: translateY(100%);
        }
    }
</style>
