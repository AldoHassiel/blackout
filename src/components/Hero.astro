---
import { ArrowDownRight } from "@lucide/astro";
import ProximoEvento from "./ProximoEvento.astro";
---

<section class="flex flex-wrap mx-15 my-10">
    <div class="flex-2 flex flex-col gap-4">
        <span
            class="flex items-center gap-2 w-fit border border-accent bg-card px-2 py-1 text-accent text-[12px] tracking-[0.11em] font-mono"
        >
            <span class="block w-1 h-1 rounded-full bg-accent animate-ping"
            ></span>
            SISTEMA ONLINE / SECTOR 07
        </span>

        <h1
            class="text-[110px] leading-none font-mono font-bold tracking-[-0.38rem]"
        >
            EL SISTEMA
            <span class="block text-accent">TE OBSERVA</span>
        </h1>

        <p class="text-muted-foreground text-lg max-w-xl">
            BLACKOUT es la comunidad de quienes convierten la curiosidad en
            capacidad. Practicamos hacking ético, compartimos conocimiento y
            competimos para descubrir hasta dónde puede llegar nuestra mente.
        </p>
        <em class="text-muted-foreground tracking-widest"
            >Demuestra que ningún sistema es seguro.</em
        >

        <div class="flex gap-5 font-mono">
            <a
                href="#modalidades"
                class="flex items-center gap-2 bg-accent text-black font-bold px-4 py-3 text-[10px] tracking-[0.20em] hover:bg-white transition-all cursor-pointer"
                >ENTRAR EN LA OPERACIÓN
                <ArrowDownRight size={15} />
            </a>
            <a
                href="#comunidad"
                class="border border-border px-4 py-3 text-[10px] tracking-[0.20em] text-muted-foreground hover:border-white hover:text-white cursor-pointer transition-all"
                >CONOCER LA COMUNIDAD</a
            >
        </div>
    </div>

    <ProximoEvento />
</section>
