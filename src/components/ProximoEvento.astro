---
import { RadioIcon } from "@lucide/astro";
import Escena from "./Escena.astro";

const fecha = new Date();
const dia = fecha.getDate().toString().padStart(2, "0");
const mes = (fecha.getMonth() + 1).toString().padStart(2, "0");
const año = fecha.getFullYear().toString().slice(-2);

const horas = "02";
const minutos = "47";
const segundos = "56";
---

<article
    id="en-vivo"
    class="min-w-0 flex-1 overflow-hidden border border-border bg-card flex flex-col"
>
    <div class="flex justify-between items-center gap-3 border-b border-b-border px-4 sm:px-6">
        <div class="flex items-center gap-2 text-[11px] py-4">
            <RadioIcon class="text-accent animate-pulse" size={19} />
            <p class="text-muted-foreground tracking-[0.15em]">
                PRÓXIMA OPERACIÓN
            </p>
        </div>

        <p class="text-[11px] text-accent tracking-[0.15em]">LIVE</p>
    </div>

    <figure class="relative overflow-hidden border-b border-border">
        <Escena
            escena="evento"
            alt="Ilustración de la apertura de una conferencia de ciberseguridad, con un ponente frente a los asistentes."
            sizes="(min-width: 1280px) 33vw, (min-width: 1024px) calc(100vw - 120px), (min-width: 640px) calc(100vw - 64px), calc(100vw - 32px)"
            class="aspect-[16/7] object-center"
            eager
        />
        <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/90 to-transparent px-4 pb-3 pt-8 font-mono text-[9px] tracking-widest text-white sm:px-6">
            COMPITE. APRENDE. CONECTA.
        </figcaption>
    </figure>

    <div class="flex flex-1 flex-col gap-2 px-4 py-5 sm:px-6">
        <p class="text-accent font-mono text-xs tracking-widest">
            BLACKOUT // CTF 001
        </p>
        <h2 class="font-mono font-bold text-xl">LA CAÍDA DE EVIL CORP</h2>

        <p class="text-muted-foreground text-sm">
            El sistema se reinicia en:
        </p>
        <div class="font-mono flex gap-5">
            <div class="flex flex-col items-center">
                <span class="text-5xl font-bold text-accent" id="horas"
                    >{horas}</span
                >
                <span class="text-xs text-muted-foreground tracking-widest"
                    >HORAS</span
                >
            </div>
            <div class="flex flex-col items-center">
                <span class="text-5xl font-bold text-accent" id="minutos"
                    >{minutos}</span
                >
                <span class="text-xs text-muted-foreground tracking-widest"
                    >MIN</span
                >
            </div>
            <div class="flex flex-col items-center">
                <span class="text-5xl font-bold text-accent" id="segundos"
                    >{segundos}</span
                >
                <span class="text-xs text-muted-accent tracking-widest"
                    >SEG</span
                >
            </div>
        </div>
    </div>

    <div class="flex justify-between gap-3 text-[11px] px-4 py-4 border-t border-t-border sm:px-6">
        <p class="text-muted-foreground">64 EQUIPOS INSCRITOS</p>
        <p>{dia}.{mes}.{año}</p>
    </div>
</article>

<script>
    const $horas = document.getElementById("horas");
    const $minutos = document.getElementById("minutos");
    const $segundos = document.getElementById("segundos");

    let horas = Number($horas?.textContent);
    let minutos = Number($minutos?.textContent);
    let segundos = Number($segundos?.textContent);

    let temporizador = setInterval(() => {
        if (!$horas || !$minutos || !$segundos) return;

        segundos--;

        $horas.textContent = horas.toString().padStart(2, "0");
        $minutos.textContent = minutos.toString().padStart(2, "0");
        $segundos.textContent =
            segundos == -1 ? "00" : segundos.toString().padStart(2, "0");

        if (horas == 0 && minutos == 0 && segundos == 0) {
            clearInterval(temporizador);

            $horas.textContent = "--";
            $minutos.textContent = "--";
            $segundos.textContent = "--";
        }

        if (segundos < 0) {
            segundos = 60;
            minutos--;
        }

        if (minutos < 0) {
            minutos = 59;
            horas--;
        }
    }, 1000);
</script>
