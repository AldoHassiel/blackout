---
import { LockKeyholeIcon, TerminalIcon, HatGlassesIcon } from "@lucide/astro";
import Curso from "./Curso.astro";
import Escena from "./Escena.astro";
---

<section
    id="aprende"
    class="mx-4 space-y-8 py-16 sm:mx-8 sm:space-y-10 sm:py-20 lg:mx-15 lg:space-y-15 lg:py-30 border-y border-border timeline-view animate-blurred-fade-in animate-range-[entry_10%_entry_100%]"
>
    <div class="flex flex-col gap-6 items-start xl:flex-row xl:justify-between xl:items-center">
        <div class="min-w-0 space-y-5">
            <p class="text-accent font-mono text-xs tracking-widest">
                02 / ACADEMIA BLACKOUT
            </p>

            <h2 class="text-3xl sm:text-5xl xl:text-6xl font-mono font-bold">
                CADA <b class="text-accent">FLAG</b> ABRE
                <span class="block"
                    >UNA NUEVA <b class="text-accent">PUERTA</b></span
                >
            </h2>
        </div>

        <div class="grid w-full gap-4 sm:grid-cols-2 sm:items-center xl:block xl:w-100 xl:shrink-0 xl:space-y-4">
            <figure class="relative overflow-hidden border border-border bg-card">
                <Escena
                    escena="academia"
                    alt="Ilustración de tres personas compartiendo conocimientos y resolviendo un ejercicio práctico alrededor de una computadora."
                    sizes="(min-width: 1280px) 400px, (min-width: 640px) 45vw, calc(100vw - 32px)"
                    class="aspect-video"
                />
                <figcaption class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/90 to-transparent px-4 pb-3 pt-8 font-mono text-[9px] tracking-widest text-white">
                    // APRENDER ES COMPARTIR
                </figcaption>
            </figure>
            <p class="max-w-100 text-muted-foreground xl:w-100">
                Lecciones prácticas, laboratorios reales y una comunidad que no
                guarda secretos.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3">
        <Curso
            Icono={LockKeyholeIcon}
            nivel="NIVEL 01 / FUNDAMENTOS"
            titulo="PIENSA COMO UN ATACANTE"
            descripcion="Reconocimiento, superficies de ataque y la lógica detrás de cada vulnerabilidad."
        />

        <Curso
            Icono={TerminalIcon}
            nivel="NIVEL 02 / OPERATIVO"
            titulo="ROMPE EL SISTEMA"
            descripcion="Practica explotación , escalada de privilegios y análisis en entornos controlados."
        />

        <Curso
            Icono={HatGlassesIcon}
            nivel="NIVEL 03 / AVANZADO"
            titulo="DEJA CERO RASTROS"
            descripcion="Reconocimiento, superficies de ataque y la lógica detrás de cada vulnerabilidad."
        />
    </div>
</section>
