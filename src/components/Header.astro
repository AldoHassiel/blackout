---
import { Terminal } from "@lucide/astro";
---

<header
    class="flex justify-between items-center mx-5 px-10 py-5 border-b border-border animate-blurred-fade-in"
>
    <a
        href="/"
        class="flex items-center gap-3 font-mono text-lg font-bold tracking-[0.25em]"
    >
        <span class="border border-accent text-accent p-1">
            <Terminal size="15" />
        </span>
        <span>BLACKOUT</span>
        <span class="text-accent">_</span>
    </a>

    <nav
        class="flex justify-center items-center gap-5 text-[10px] text-gris tracking-[0.18em]"
    >
        <a href="#nosotros" class="hover:text-accent transition-colors"
            >NOSOTROS</a
        >
        <a href="#aprende" class="hover:text-accent transition-colors"
            >APRENDE</a
        >
        <a href="#compite" class="hover:text-accent transition-colors"
            >COMPITE</a
        >
        <a href="#ranking" class="hover:text-accent transition-colors"
            >RANKING</a
        >

        <span>|</span>

        <a
            href="#en-vivo"
            class="flex gap-2 justify-center items-center text-accent"
        >
            <span class="block w-2 h-2 bg-accent rounded-full animate-pulse"
            ></span>
            <span class="hover:text-gray-300">EN VIVO</span>
        </a>

        <span>|</span>

        <div class="space-x-3">
            <button
                id="btn-tema-rojo"
                class="h-2 w-2 rounded-full bg-[#c8472d] ring-2 ring-accent ring-offset-2 ring-offset-background cursor-pointer"
            ></button>

            <button
                id="btn-tema-verde"
                class="h-2 w-2 rounded-full bg-[#74d99b] ring-accent ring-offset-2 ring-offset-background cursor-pointer"
            ></button>
        </div>
    </nav>

    <button
        class="border border-accent font-mono text-accent px-4 py-2 text-[10px] tracking-[0.2em] cursor-pointer hover:bg-accent hover:text-black transition-colors"
        >UNIRSE A BLACKOUT</button
    >
</header>

<script>
    const $root = document.getElementById("root");
    const $btnTemaRojo = document.getElementById("btn-tema-rojo");
    const $btnTemaVerde = document.getElementById("btn-tema-verde");

    $btnTemaRojo?.addEventListener("click", () => {
        $root?.classList.remove("theme-green");
        $root?.classList.add("theme-red");

        $btnTemaVerde?.classList.remove("ring-2");
        $btnTemaRojo?.classList.add("ring-2");
    });

    $btnTemaVerde?.addEventListener("click", () => {
        $root?.classList.remove("theme-red");
        $root?.classList.add("theme-green");

        $btnTemaRojo?.classList.remove("ring-2");
        $btnTemaVerde?.classList.add("ring-2");
    });
</script>
