---
import {
    CrosshairIcon,
    ShieldIcon,
    NetworkIcon,
    TrophyIcon,
    ArrowUpRightIcon,
    ChevronRightIcon,
} from "@lucide/astro";
import ModoDeJuego from "./ModoDeJuego.astro";
import Desafio from "./Desafio.astro";
import Duelo from "./Duelo.astro";
---

<section
    id="compite"
    class="mx-4 py-16 space-y-8 sm:mx-8 sm:py-20 sm:space-y-10 lg:mx-15 lg:py-30 lg:space-y-15 border-b border-border timeline-view animate-blurred-fade-in animate-range-[entry_10%_entry_100%]"
>
    <div class="flex flex-col gap-6 items-start xl:flex-row xl:justify-between xl:items-center">
        <div class="min-w-0 space-y-5">
            <p class="text-accent font-mono text-xs tracking-widest">
                03 / DOS FORMAS DE JUGAR
            </p>

            <h2 class="text-3xl sm:text-5xl xl:text-6xl font-mono font-bold">
                ELIGE TU VECTOR
                <span class="block">DE <b class="text-accent">ATAQUE</b></span>
            </h2>
        </div>

        <p class="max-w-85 text-muted-foreground xl:w-85">
            ¿Crees que tienes las habilidades suficientes para ganar el duelo?
            Demuestralo.
        </p>
    </div>

    <Duelo />

    <div id="modalidades" class="grid scroll-mt-6 grid-cols-1 md:grid-cols-2">
        <ModoDeJuego
            Icono={CrosshairIcon}
            numero="001"
            titulo="CTF / UN SISTEMA. LAS MISMAS FLAGS."
            subtitulo="CAPTURA LA BANDERA"
            descripcion="Todos los jugadores entran al mismo sistema y persiguen las mismas flags. Encuentra la ruta, encadena vulnerabilidades y captura la bandera dorada antes que nadie."
        />

        <ModoDeJuego
            Icono={ShieldIcon}
            numero="002"
            titulo="GUERRA DE SISTEMAS"
            subtitulo="ATAQUE Y DEFENSA"
            descripcion="Ataca su sistema. Defiende el tuyo. Enfréntate a otros equipos sobre la misma arquitectura y sobrevive a un torneo donde cada decisión puede cambiar el marcador."
        />
    </div>

    <div class="flex flex-col lg:flex-row">
        <article
            class="min-w-0 p-4 sm:p-8 border border-border bg-card flex flex-col justify-between gap-8 sm:gap-10 flex-2"
        >
            <div class="flex items-center justify-between gap-3">
                <p class="text-accent text-xs font-mono tracking-widest">
                    // VULNERABILIDADES DETECTADAS
                </p>
                <NetworkIcon class="shrink-0 text-muted-foreground" />
            </div>

            <div>
                <Desafio
                    icono="⌁"
                    titulo="zero_day"
                    tipo="PWN"
                    puntos="900"
                    estado="ABIERTO"
                />

                <Desafio
                    icono="◉"
                    titulo="black_ice"
                    tipo="FORENSE"
                    puntos="750"
                    estado="ABIERTO"
                />

                <Desafio
                    icono="◈"
                    titulo="ghost_protocol"
                    tipo="CRIPTOGRAFÍA"
                    puntos="500"
                    estado="NUEVO"
                />
            </div>

            <a
                href="/"
                class="flex min-h-11 items-center gap-2 text-xs font-mono tracking-widest cursor-pointer hover:text-accent xl:min-h-0 xl:hover:scale-105 xl:hover:translate-x-10 transition-all"
            >
                VER TODOS LOS DESAFÍOS
                <ChevronRightIcon size={15} />
            </a>
        </article>

        <article
            class="min-w-0 flex-1 p-6 sm:p-8 bg-accent flex flex-col justify-between gap-10"
        >
            <TrophyIcon class="text-background" />

            <div class="border-b border-border flex-1 space-y-3 pb-6 lg:pb-0">
                <h2 class="font-mono font-bold text-2xl text-background">
                    TU PRIMER EXPLOIT EMPIEZA AQUÍ
                </h2>
                <p class="text-secondary text-sm">
                    Únete a una comunidad que comparte conocimiento, construye
                    herramientas y compite con propósito.
                </p>
            </div>

            <div
                class="flex justify-between items-center text-background font-mono tracking-widest text-xs font-bold cursor-pointer"
            >
                <a href="/" class="flex min-h-11 items-center xl:min-h-0">SOLICITAR ACCESO</a>
                <ArrowUpRightIcon size={15} />
            </div>
        </article>
    </div>
</section>
