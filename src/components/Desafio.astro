---
export interface Props {
    icono: string;
    titulo: string;
    tipo:
        | "CRIPTOGRAFÍA"
        | "PWN"
        | "FORENSE"
        | "OSINT"
        | "WEB EXPLOTATION"
        | "INGENIERÍA INVERSA";
    puntos: string;
    estado: "ABIERTO" | "CERRADO" | "NUEVO";
}

const { icono, titulo, tipo, puntos, estado } = Astro.props;
---

<div class="border-b border-border flex justify-between items-center py-2">
    <div class="flex items-center justify-center gap-5">
        <p class="text-xl text-accent">{icono}</p>

        <div>
            <p class="text-sm font-mono">{titulo}</p>
            <p
                class="text-[10px] font-mono tracking-widest text-muted-foreground"
            >
                {tipo}
            </p>
        </div>
    </div>

    <div class="flex items-center text-xs font-mono gap-5">
        <p class="text-muted-foreground">{puntos} pts</p>
        <p class="text-accent">{estado}</p>
    </div>
</div>
